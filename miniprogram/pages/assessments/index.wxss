.assessment-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f0f2f6;
}

.assessment-item:last-child {
  border-bottom: none;
}

.assessment-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.assessment-main {
  flex: 1;
  margin-right: 12rpx;
}

.report-item {
  padding: 10rpx 0;
  border-bottom: 2rpx solid #f0f2f6;
}

.report-item:last-child {
  border-bottom: none;
}

.report-title {
  font-weight: 600;
}
