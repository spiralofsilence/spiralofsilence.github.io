.tab-bar {
  display: flex;
  background: #f0f2f6;
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #8892a0;
}

.tab.active {
  background: #2f6bff;
  color: #ffffff;
}

.signature-canvas {
  width: 100%;
  height: 260rpx;
  border: 2rpx solid #e4e8f0;
  border-radius: 12rpx;
  background: #ffffff;
}

.canvas-wrap {
  padding: 12rpx 0;
}
