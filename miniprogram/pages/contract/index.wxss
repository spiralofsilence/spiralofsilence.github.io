.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.status {
  font-weight: 600;
}

.status.unsigned {
  color: #8892a0;
}

.status.signed {
  color: #2f6bff;
}

.status.effective {
  color: #2fbf6b;
}

.section {
  margin-bottom: 16rpx;
}

.file-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.signature-preview {
  width: 100%;
  height: 200rpx;
  margin-top: 12rpx;
  border: 2rpx solid #e4e8f0;
  border-radius: 12rpx;
}

.log-item {
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f0f2f6;
}

.log-item:last-child {
  border-bottom: none;
}

.log-title {
  font-weight: 600;
}
