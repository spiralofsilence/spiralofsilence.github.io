<view class="page" wx:if="{{contract}}">
  <view class="card">
    <view class="section-header">
      <text class="section-title">{{contractTitle || '待签署合同'}}</text>
      <text class="status {{contract.status}}">{{contract.status === 'unsigned' ? '未签署' : contract.status === 'signed' ? '已签署' : '已生效'}}</text>
    </view>
    <view wx:if="{{!templateFile}}" class="muted">
      暂无合同文件，请联系顾问上传。
    </view>
    <view wx:if="{{templateFile}}" class="file-row">
      <text class="muted">合同文件：{{contractTitle}}</text>
      <text class="link" bindtap="openTemplateFile">打开</text>
    </view>
    <view class="muted" wx:if="{{signedAtLabel}}">
      签署时间：{{signedAtLabel}}
    </view>
    <view class="muted" wx:if="{{effectiveAtLabel}}">
      生效时间：{{effectiveAtLabel}}
    </view>
  </view>

  <view class="card">
    <view class="section-header">
      <text class="section-title">签署信息</text>
    </view>
    <view wx:if="{{contract.status === 'unsigned'}}" class="muted">
      当前合同尚未签署。
    </view>
    <view wx:else>
      <text class="muted">签署方式：{{contract.signatureType === 'hand' ? '手写' : '文字'}}</text>
      <view class="muted">签署人：{{contract.signerName || '未填写'}}</view>
      <image wx:if="{{contract.signaturePath}}" class="signature-preview" mode="aspectFit" src="{{contract.signaturePath}}" />
    </view>
    <view style="margin-top: 16rpx;">
      <button wx:if="{{contract.status === 'unsigned'}}" class="button-primary" bindtap="startSign" disabled="{{!templateFile}}">签署合同</button>
      <button wx:else class="button-ghost" bindtap="startSign" disabled="{{!templateFile}}">重新签署</button>
      <text wx:if="{{!templateFile}}" class="muted" style="margin-top: 8rpx; display: block;">
        上传合同后才能签署。
      </text>
    </view>
  </view>

  <view class="card" wx:if="{{isStaff}}">
    <view class="section-header">
      <text class="section-title">合同管理</text>
      <text class="muted">顾问/管理员</text>
    </view>
    <text class="muted">上传合同文件后，父母角色可查看并签署。</text>
    <view style="margin-top: 12rpx;">
      <input class="input" placeholder="合同显示名称" value="{{displayNameInput}}" bindinput="onDisplayNameInput" />
      <button class="button-ghost" size="mini" bindtap="saveDisplayName" style="margin-top: 8rpx;">保存名称</button>
    </view>
    <view style="margin-top: 12rpx;">
      <button class="button-primary" size="mini" bindtap="uploadTemplateFile">上传合同文件</button>
      <button class="button-ghost" size="mini" bindtap="openTemplateFile">预览合同</button>
      <button class="button-ghost" size="mini" bindtap="removeTemplateFile">移除合同</button>
    </view>
    <view wx:if="{{templateFile}}" class="muted" style="margin-top: 8rpx;">
      已上传：{{templateFile.name}}
    </view>
  </view>

  <view class="card" wx:if="{{contract.status !== 'unsigned'}}">
    <view class="section-header">
      <text class="section-title">必做测评</text>
      <text class="muted">{{requiredCompleted ? '已完成' : '未完成'}}</text>
    </view>
    <view wx:for="{{requiredItems}}" wx:key="id" class="log-item">
      <text class="log-title">{{item.title}}</text>
      <text class="muted">{{item.status}}</text>
    </view>
    <view style="margin-top: 12rpx;">
      <button class="button-primary" bindtap="openAssessments">进入必做测评</button>
    </view>
  </view>
</view>
