<view class="page">
  <view class="card">
    <view class="tab-bar">
      <view class="tab {{tabIndex === 0 ? 'active' : ''}}" data-index="0" bindtap="switchTab">手写签名</view>
      <view class="tab {{tabIndex === 1 ? 'active' : ''}}" data-index="1" bindtap="switchTab">文字签名</view>
    </view>
    <view wx:if="{{tabIndex === 0}}" class="canvas-wrap">
      <canvas
        canvas-id="signCanvas"
        class="signature-canvas"
        bindtouchstart="startDraw"
        bindtouchmove="moveDraw"
      />
      <view class="row" style="margin-top: 12rpx;">
        <text class="muted">在框内签名</text>
        <button class="button-ghost" size="mini" bindtap="clearCanvas">清空</button>
      </view>
    </view>
    <view wx:else>
      <input class="input" placeholder="请输入签名姓名" value="{{typedName}}" bindinput="onNameInput" />
      <text class="muted" style="margin-top: 8rpx; display: block;">
        将以文字形式存档
      </text>
    </view>
    <view style="margin-top: 16rpx;">
      <button class="button-primary" bindtap="saveSignature">保存签名</button>
    </view>
  </view>
</view>
