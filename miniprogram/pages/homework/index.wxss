.stats-row > view {
  flex: 1;
  text-align: center;
}

.stats-row > view:first-child {
  text-align: left;
}

.stats-row > view:last-child {
  text-align: right;
}

.task-item {
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f0f2f6;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.task-item:last-child {
  border-bottom: none;
}

.task-item.active {
  background: #fbf7ef;
  border-radius: 12rpx;
  padding: 12rpx;
}

.task-title {
  font-weight: 600;
  font-size: 28rpx;
  color: #1f5a3a;
}

.attachment-list {
  margin-top: 12rpx;
}

.attachment-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 2rpx solid #f0f2f6;
}

.attachment-item:last-child {
  border-bottom: none;
}

.remove {
  color: #e23c3c;
  font-size: 24rpx;
}

.log-item {
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f2f6;
}

.log-item:last-child {
  border-bottom: none;
}

.log-title {
  font-weight: 600;
}

.status-row {
  margin-top: 6rpx;
}

.status.submitted {
  color: #ff8f2f;
}

.status.reviewed {
  color: #2fbf6b;
}

.comment-box {
  margin-top: 8rpx;
}

.checkbox-row {
  margin-top: 8rpx;
}

.checkbox-label {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #1f5a3a;
}
