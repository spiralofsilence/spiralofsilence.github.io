.card-title {
  font-size: 32rpx;
}

.hero-card {
  background: linear-gradient(180deg, #ffffff 0%, #fbf7ef 100%);
}

.summary-grid {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.summary-item {
  flex: 1;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx;
  border: 2rpx solid #efe2c6;
  text-align: center;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f5a3a;
  margin-top: 6rpx;
}
