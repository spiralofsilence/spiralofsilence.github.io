<view class="page">
  <view class="card">
    <view class="section-header">
      <text class="section-title">角色设置</text>
    </view>
    <picker mode="selector" range="{{roles}}" value="{{roleIndex}}" bindchange="onRoleChange">
      <view class="picker">{{roles[roleIndex]}}</view>
    </picker>
  </view>

  <view class="card">
    <view class="section-header">
      <text class="section-title">基础信息</text>
    </view>
    <input class="input" placeholder="昵称/称呼" value="{{nickname}}" bindinput="onNicknameInput" />
    <input class="input" placeholder="机构/组织（可选）" value="{{organization}}" bindinput="onOrgInput" style="margin-top: 12rpx;" />
  </view>

  <view class="card">
    <view class="section-header">
      <text class="section-title">AI配置</text>
      <text class="muted">仅本地保存</text>
    </view>
    <input class="input" placeholder="OpenAI API Key" value="{{aiApiKey}}" password bindinput="onKeyInput" />
    <view class="row" style="margin-top: 12rpx;">
      <text class="muted">使用后端代理（推荐）</text>
      <switch checked="{{aiUseProxy}}" bindchange="onProxyToggle" />
    </view>
  </view>

  <view class="card">
    <view class="section-header">
      <text class="section-title">合同与服务</text>
    </view>
    <view class="link" bindtap="openContract">签署合同</view>
    <view class="link" bindtap="openService" style="margin-top: 12rpx;">服务进度</view>
    <view class="link" bindtap="openHomework" style="margin-top: 12rpx;">作业打卡</view>
  </view>

  <view class="card">
    <view class="section-header">
      <text class="section-title">订阅消息</text>
      <text class="muted">需要模板ID</text>
    </view>
    <input class="input" placeholder="任务提醒模板ID" value="{{taskReminderTemplateId}}" bindinput="onTaskTemplateInput" />
    <input class="input" placeholder="求助提醒模板ID" value="{{helpAlertTemplateId}}" bindinput="onHelpTemplateInput" style="margin-top: 12rpx;" />
    <view style="margin-top: 12rpx;">
      <button class="button-ghost" size="mini" bindtap="requestSubscribe">订阅提醒</button>
    </view>
    <view class="muted" wx:if="{{subscriptionResult}}" style="margin-top: 8rpx;">
      已记录订阅授权
    </view>
  </view>

  <view class="card">
    <view class="section-header">
      <text class="section-title">其他</text>
    </view>
    <view class="link" bindtap="showPrivacy">查看隐私政策</view>
    <view class="link" bindtap="clearData" style="margin-top: 12rpx;">清空本地数据</view>
  </view>

  <view style="margin-top: 12rpx;">
    <button class="button-primary" bindtap="saveProfile">保存资料</button>
  </view>
</view>
