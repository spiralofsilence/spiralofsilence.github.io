<view class="page page-enter">
  <view class="card shadow-soft" wx:if="{{!roleSaved || role === '父母'}}">
    <view class="section-header">
      <text class="section-title">角色设置</text>
    </view>
    <picker mode="selector" range="{{roles}}" value="{{roleIndex}}" bindchange="onRoleChange">
      <van-cell title="当前角色" value="{{roles[roleIndex]}}" is-link />
    </picker>
    <text class="muted" style="margin-top: 12rpx; display: block;">
      选择角色后保存，继续下一步。
    </text>
    <view style="margin-top: 12rpx;">
      <van-button type="primary" size="small" bind:click="saveProfile">确认角色</van-button>
    </view>
  </view>

  <view class="card" wx:if="{{roleSaved && role === '父母'}}">
    <view class="section-header">
      <text class="section-title">基础信息</text>
    </view>
    <van-cell-group inset="{{false}}">
      <van-field label="姓名" placeholder="真实姓名" value="{{fullName}}" bind:input="onNicknameInput" />
      <van-field label="城市" placeholder="所在城市" value="{{city}}" bind:input="onOrgInput" />
      <van-field label="联系方式" placeholder="手机号/微信号" value="{{contact}}" bind:input="onContactInput" />
    </van-cell-group>
    <view style="margin-top: 12rpx;">
      <van-button type="primary" size="small" bind:click="saveProfile">保存基础信息</van-button>
    </view>
  </view>

  <view class="card" wx:if="{{roleSaved && role === '父母' && pendingContract}}">
    <view class="section-header">
      <text class="section-title">待签署合同</text>
    </view>
    <text class="muted">{{pendingContract.templateName || '合同'}} · 待签署</text>
    <view style="margin-top: 10rpx;">
      <van-button type="primary" size="small" bind:click="openContract">查看并签署</van-button>
    </view>
  </view>

  <view class="card" wx:if="{{roleSaved && role === '父母'}}">
    <view class="section-header">
      <text class="section-title">合同与服务</text>
    </view>
    <van-cell title="签署合同" is-link bind:click="openContract" />
    <van-cell title="服务进度" is-link bind:click="openService" />
    <van-cell title="作业打卡" is-link bind:click="openHomework" />
  </view>

  <view class="card" wx:if="{{roleSaved && isStaff && !adminHasPassword}}">
    <view class="section-header">
      <text class="section-title">管理员设置密码</text>
    </view>
    <van-field label="设置密码" type="password" placeholder="至少6位" value="{{adminPasswordInput}}" bind:input="onAdminPasswordInput" />
    <van-field label="确认密码" type="password" placeholder="再次输入" value="{{adminPasswordConfirm}}" bind:input="onAdminPasswordConfirmInput" />
    <view style="margin-top: 12rpx;">
      <van-button type="primary" size="small" bind:click="setAdminPassword">完成设置</van-button>
    </view>
  </view>

  <view class="card" wx:if="{{roleSaved && isStaff && adminHasPassword && !adminLoggedIn}}">
    <view class="section-header">
      <text class="section-title">管理员登录</text>
    </view>
    <van-field label="密码" type="password" placeholder="请输入密码" value="{{adminPasswordInput}}" bind:input="onAdminPasswordInput" />
    <view style="margin-top: 12rpx;">
      <van-button type="primary" size="small" bind:click="adminLogin">登录</van-button>
    </view>
  </view>

  <view class="card" wx:if="{{roleSaved && isStaff && adminLoggedIn}}">
    <view class="section-header">
      <text class="section-title">管理入口</text>
    </view>
    <van-cell title="用户管理" is-link bind:click="openUserAdmin" />
    <van-cell title="合同模板管理" is-link bind:click="openContractAdmin" />
    <van-cell title="测评模板管理" is-link bind:click="openAssessmentAdmin" />
  </view>

  <view class="card" wx:if="{{roleSaved && role === '父母'}}">
    <view class="section-header">
      <text class="section-title">其他</text>
    </view>
    <van-cell title="查看隐私政策" is-link bind:click="showPrivacy" />
    <button class="button-ghost contact-btn" open-type="contact">联系客服</button>
    <van-cell title="清空本地数据" is-link bind:click="clearData" />
  </view>
</view>
