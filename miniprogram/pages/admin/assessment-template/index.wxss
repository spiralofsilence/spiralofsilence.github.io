.log-item {
  padding: 10rpx 0;
  border-bottom: 2rpx solid #f1e6d0;
}

.log-item:last-child {
  border-bottom: none;
}

.checkbox-row {
  margin-top: 8rpx;
}

.checkbox-label {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #1f5a3a;
}

.type-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.scale-config {
  margin-top: 8rpx;
}
