.onboarding {
  min-height: 100vh;
  padding: 40rpx 28rpx;
  background: linear-gradient(180deg, #f6f2e9 0%, #fcfaf5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-indicator {
  text-align: right;
  margin-bottom: 20rpx;
}

.step-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  border: 2rpx solid #eadfc8;
  box-shadow: 0 16rpx 30rpx rgba(45, 36, 20, 0.08);
  width: 100%;
}

.welcome {
  padding: 36rpx 20rpx;
  text-align: center;
}

.welcome-title {
  font-size: 42rpx;
  font-weight: 600;
  color: #1f5a3a;
  letter-spacing: 2rpx;
  animation: fadeUp 1s ease;
}

.welcome-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8a7b5c;
  line-height: 1.7;
  animation: fadeUp 1.4s ease;
}

.welcome-cta {
  margin-top: 24rpx;
  text-align: center;
}

.step-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.wechat-card {
  margin: 16rpx 0;
  padding: 16rpx;
  background: #f7f2e7;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

@keyframes fadeUp {
  0% {
    opacity: 0;
    transform: translateY(16rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}
