.summary-row > view {
  flex: 1;
  text-align: center;
}

.summary-row > view:first-child {
  text-align: left;
}

.summary-row > view:last-child {
  text-align: right;
}

.setting-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.setting-item .label {
  flex: 1;
}

.input.small {
  width: 120rpx;
  margin: 0 12rpx;
}

.keyword-list {
  display: flex;
  flex-wrap: wrap;
}

.keyword-item {
  display: flex;
  align-items: center;
  background: #f0f4ff;
  color: #2f6bff;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin: 0 12rpx 12rpx 0;
  font-size: 24rpx;
}

.keyword-item .remove {
  margin-left: 12rpx;
  color: #e23c3c;
  font-size: 22rpx;
}

.button-primary.small {
  padding: 0 20rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.log-item {
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f0f2f6;
}

.log-item:last-child {
  border-bottom: none;
}

.log-title {
  font-weight: 600;
}
