.scene-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.picker {
  background: #f0f2f6;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.question-card {
  margin-bottom: 12rpx;
}

.question-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.option-list {
  display: flex;
  flex-direction: column;
}

.option-item {
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e4e8f0;
  margin-bottom: 8rpx;
  font-size: 22rpx;
}

.option-item.active {
  background: #2f6bff;
  border-color: #2f6bff;
  color: #ffffff;
}

.scale-box {
  margin-top: 6rpx;
}

.scale-value {
  margin: 6rpx 0;
  font-size: 22rpx;
  color: #1f2d3d;
}
