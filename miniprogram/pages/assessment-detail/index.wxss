.scene-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.picker {
  background: #f0f2f6;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.question-card {
  margin-bottom: 16rpx;
}

.question-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.option-list {
  display: flex;
  flex-direction: column;
}

.option-item {
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e4e8f0;
  margin-bottom: 10rpx;
  font-size: 24rpx;
}

.option-item.active {
  background: #2f6bff;
  border-color: #2f6bff;
  color: #ffffff;
}

.scale-box {
  margin-top: 6rpx;
}

.scale-value {
  margin: 8rpx 0;
  font-size: 24rpx;
  color: #1f2d3d;
}
