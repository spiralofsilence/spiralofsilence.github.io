<view class="page">
  <view class="card">
    <view class="section-header">
      <text class="section-title">今日任务库</text>
      <text class="muted">{{todayKey}}</text>
    </view>
    <view style="margin-bottom: 12rpx;">
      <button class="button-ghost" size="mini" bindtap="subscribeTaskReminder">
        订阅任务提醒
      </button>
    </view>
    <view wx:for="{{tasks}}" wx:key="id" class="task-item">
      <view class="task-main">
        <text class="task-title">{{item.title}}</text>
        <text class="muted">{{item.description}}</text>
        <view style="margin-top: 8rpx;">
          <text wx:for="{{item.tags}}" wx:key="tag" class="tag">{{item}}</text>
        </view>
      </view>
      <view class="task-actions">
        <button class="button-primary" size="mini" bindtap="markComplete" data-task="{{item}}">
          完成
        </button>
        <button class="button-ghost" size="mini" bindtap="openRecord" data-task="{{item}}">
          记录反馈
        </button>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-header">
      <text class="section-title">今日完成记录</text>
    </view>
    <view wx:if="{{todayLogs.length === 0}}" class="muted">还没有记录哦</view>
    <view wx:for="{{todayLogs}}" wx:key="id" class="log-item">
      <text class="log-title">{{item.taskTitle}}</text>
      <text class="muted">{{item.timeLabel}}</text>
    </view>
  </view>
</view>
